---
// Full-page twinkling starfield with gentle parallax and the odd shooting star.
---

<canvas class="starfield" data-starfield aria-hidden="true"></canvas>

<script>
  interface Star {
    x: number;
    y: number;
    z: number; // depth 0.2–1, drives size, brightness and parallax
    phase: number;
    speed: number;
    hue: number;
  }
  interface Meteor {
    x: number;
    y: number;
    vx: number;
    vy: number;
    life: number;
  }

  const canvas = document.querySelector<HTMLCanvasElement>('[data-starfield]');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let width = 0;
    let height = 0;
    let stars: Star[] = [];
    let meteors: Meteor[] = [];
    let pointerX = 0;
    let pointerY = 0;
    let offsetX = 0;
    let offsetY = 0;
    let nextMeteor = 2500;
    let last = performance.now();

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.round(Math.min(260, (width * height) / 6500));
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        z: 0.2 + Math.random() * 0.8,
        phase: Math.random() * Math.PI * 2,
        speed: 0.6 + Math.random() * 1.8,
        hue: Math.random() < 0.2 ? 40 : 230,
      }));
    };

    const draw = (time: number) => {
      const dt = Math.min(64, time - last);
      last = time;
      ctx.clearRect(0, 0, width, height);

      offsetX += (pointerX - offsetX) * 0.04;
      offsetY += (pointerY - offsetY) * 0.04;

      for (const s of stars) {
        const twinkle = reduceMotion ? 0.8 : 0.55 + 0.45 * Math.sin(time * 0.001 * s.speed + s.phase);
        const px = (s.x + offsetX * s.z * 18 + width) % width;
        const py = (s.y + offsetY * s.z * 18 + height) % height;
        const r = s.z * 1.4;
        ctx.globalAlpha = twinkle * s.z;
        ctx.fillStyle = `hsl(${s.hue} 30% 92%)`;
        ctx.beginPath();
        ctx.arc(px, py, r, 0, Math.PI * 2);
        ctx.fill();
        if (s.z > 0.85) {
          ctx.globalAlpha = twinkle * 0.25;
          ctx.fillRect(px - r * 3, py - 0.4, r * 6, 0.8);
          ctx.fillRect(px - 0.4, py - r * 3, 0.8, r * 6);
        }
      }

      if (!reduceMotion) {
        nextMeteor -= dt;
        if (nextMeteor <= 0) {
          meteors.push({
            x: Math.random() * width * 0.8 + width * 0.2,
            y: Math.random() * height * 0.35,
            vx: -(6 + Math.random() * 4),
            vy: 2.4 + Math.random() * 2,
            life: 1,
          });
          nextMeteor = 4000 + Math.random() * 6000;
        }
        meteors = meteors.filter((m) => m.life > 0);
        for (const m of meteors) {
          m.x += m.vx * (dt / 16);
          m.y += m.vy * (dt / 16);
          m.life -= dt / 1100;
          ctx.globalAlpha = Math.max(0, m.life) * 0.8;
          ctx.strokeStyle = '#f4f1ff';
          ctx.lineWidth = 1.6;
          ctx.beginPath();
          ctx.moveTo(m.x, m.y);
          ctx.lineTo(m.x - m.vx * 14, m.y - m.vy * 14);
          ctx.stroke();
        }
      }
      ctx.globalAlpha = 1;
      if (!reduceMotion) requestAnimationFrame(draw);
    };

    window.addEventListener('resize', resize, { passive: true });
    window.addEventListener(
      'pointermove',
      (e) => {
        pointerX = (e.clientX / width - 0.5) * 2;
        pointerY = (e.clientY / height - 0.5) * 2;
      },
      { passive: true },
    );

    resize();
    requestAnimationFrame(draw);
  }
</script>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>
