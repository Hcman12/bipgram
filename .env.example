# ─────────────────────────────────────────────────────────────────────────────
#  Bipgram coming-soon page: environment variables
#
#  1. Copy this file to `.env`  (cp .env.example .env)
#  2. Fill in the values
#  3. Restart `npm run dev`
#
#  Every variable is validated at startup (schema in astro.config.mjs), so a typo
#  fails with a clear error instead of shipping a broken page.
#
#  On Netlify / Vercel / Cloudflare Pages, set the same names in the dashboard's
#  "Environment variables" section instead of uploading .env.
#
#  NOTE: everything here starts with PUBLIC_ and ends up in the public HTML/JS.
#  Never put passwords, API secret keys or tokens in this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────

# Your live domain. Used for canonical and social-share (Open Graph) URLs.
PUBLIC_SITE_URL=https://bipgram.com

# Launch moment for the countdown: ISO 8601 with a timezone (Z = UTC).
# Examples: 2027-03-01T18:00:00Z   or   2027-03-01T19:00:00+01:00
PUBLIC_LAUNCH_DATE=2027-03-01T18:00:00Z

# ── Page content (optional, defaults shown) ─────────────────────────────────

# Percentage shown on the construction progress bar (whole number 0–100).
PUBLIC_BUILD_PROGRESS=78

# Address shown in the footer.
PUBLIC_CONTACT_EMAIL=hello@bipgram.com

# ── Waitlist (optional) ─────────────────────────────────────────────────────

# URL that accepts POST with JSON { "email": "..." }, e.g. a Formspree form:
#   https://formspree.io/f/your-form-id
# Leave empty for demo mode: sign-ups stay in the visitor's browser only
# and are NOT collected anywhere.
PUBLIC_WAITLIST_ENDPOINT=

# ── Social links (optional, leave empty to hide that icon) ──────────────────

PUBLIC_INSTAGRAM_URL=
PUBLIC_X_URL=
PUBLIC_TIKTOK_URL=

# ── Footer credit (optional, defaults shown) ────────────────────────────────

PUBLIC_POWERED_BY_NAME=All Things Web Technology Inc
PUBLIC_POWERED_BY_URL=https://allthingswebtechnology.com
